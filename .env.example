# Copy to .env and adjust. Every variable is optional; defaults are shown.
# This project needs no API keys or secrets. Do not commit .env.

# --- Host ports (bound to 127.0.0.1 only) ---
WEB_PORT=8080
API_PORT=5080
# Only used with infrastructure/compose/docker-compose.ollama-port.yml
OLLAMA_PORT=11435

# --- Ollama ---
OLLAMA_IMAGE_TAG=0.40.4
# Preferred model. It is NOT downloaded automatically; pull it explicitly:
#   docker compose exec ollama ollama pull qwen2.5:0.5b
# ~400 MB, runs on CPU with 8 GB RAM. Larger alternatives: llama3.2:1b, llama3.2:3b, qwen2.5:3b.
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# hh:mm:ss upper bound for one generation, including model load time.
OLLAMA_INFERENCE_TIMEOUT=00:05:00

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Information
API_ENABLE_SWAGGER=false
API_MAX_CONCURRENT_GENERATIONS=2
CHAT_MAX_MESSAGE_LENGTH=8000
CHAT_DEFAULT_MAX_TOKENS=1024
CHAT_MAX_TOKENS_LIMIT=4096
# Ollama "cloud" models run on a third-party host. Keep false for local-only inference.
CHAT_ALLOW_REMOTE_MODELS=false

# --- Accounts and sessions ---
# The first visit to the dashboard creates the administrator account (no default password).
# Set true when the dashboard is served over HTTPS (cookie marked Secure).
SESSION_SECURE_COOKIE=false
# Sliding session lifetime (d.hh:mm:ss).
SESSION_LIFETIME=7.00:00:00
# Failed sign-ins per username before a 5-minute lockout.
AUTH_MAX_FAILED_LOGINS=5

# --- Web ---
# Empty = browser calls /api on the same origin (nginx proxies it). Baked in at build time.
VITE_API_BASE_URL=
