# Leave empty to call /api on the same origin (Vite dev proxy or the nginx container).
# Set only when the API is served from a different origin; the API must then list this
# dashboard's origin in Api__CorsAllowedOrigins. Never put secrets in VITE_* variables:
# they are compiled into the public JavaScript bundle.
VITE_API_BASE_URL=

# Dev-server only: where Vite proxies /api (default http://localhost:5080).
VITE_DEV_API_PROXY=http://localhost:5080
