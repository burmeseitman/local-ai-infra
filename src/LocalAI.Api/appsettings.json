{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "CorsAllowedOrigins": [],
    "MaxRequestBodyBytes": 262144,
    "MaxConcurrentGenerations": 2,
    "EnableSwagger": false
  },
  "Persistence": {
    "ConnectionString": "Data Source=data/localai.db"
  },
  "Auth": {
    "MinPasswordLength": 10,
    "MaxFailedLogins": 5,
    "LockoutDuration": "00:05:00"
  },
  "Session": {
    "CookieName": "localai.session",
    "Lifetime": "7.00:00:00",
    "SecureCookie": false,
    "KeysDirectory": "data/keys"
  },
  "Chat": {
    "DefaultModel": "qwen2.5:3b",
    "MaxMessageLength": 8000,
    "MaxConversationLength": 32000,
    "MaxMessages": 50,
    "DefaultMaxTokens": 1024,
    "MaxTokensLimit": 4096,
    "AllowRemoteModels": false,
    "ModelListCacheDuration": "00:00:05"
  },
  "Rag": {
    "EmbeddingModel": "nomic-embed-text",
    "ChunkSize": 1000,
    "ChunkOverlap": 150,
    "TopK": 5,
    "MinScore": 0.5,
    "MaxFileBytes": 10485760
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ConnectTimeout": "00:00:05",
    "MetadataTimeout": "00:00:10",
    "InferenceTimeout": "00:05:00",
    "ContextLength": 8192,
    "KeepAlive": null
  }
}
